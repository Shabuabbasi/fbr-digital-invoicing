NODE_ENV=development
PORT=4000

# directConnection=true avoids replica-set hostname discovery issues on local single-node setups
# (e.g. Docker); a real Atlas/replica-set URI normally omits it.
MONGODB_URI=mongodb://localhost:27017/intelgency_invoicing?directConnection=true

JWT_SECRET=
JWT_EXPIRES_IN=8h

CORS_ORIGIN=http://localhost:5173

# FBR Digital Invoicing integration — see docs/FBR-INTEGRATION.md.
# FBR_API_BASE_URL is optional: if left blank, the app uses FBR's known public sandbox/production
# URL for FBR_ENVIRONMENT automatically. FBR_API_TOKEN is the one thing you must supply — it's
# a secret issued to your business by FBR via the IRIS portal (iris.fbr.gov.pk), NOT something
# that can be looked up or guessed. Get it under IRIS > Digital Invoicing > Sandbox Environment.
FBR_API_BASE_URL=
FBR_API_TOKEN=
FBR_ENVIRONMENT=SANDBOX
FBR_API_TIMEOUT_MS=15000

# Used only by src/scripts/seed.ts to create the first company + admin user.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_COMPANY_NAME=Sample Company
